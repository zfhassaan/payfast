{
    "name": "zfhassaan/payfast",
    "description": "Laravel Payment Gateway Package for PayFast (Laravel 10–13)",
    "keywords": [
        "payfast",
        "php",
        "payment",
        "laravel",
        "api",
        "docs"
    ],
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "zfhassaan\\Payfast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Hassaan Ali",
            "email": "zfhassaan@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "zfhassaan\\Payfast\\Provider\\PayFastServiceProvider"
            ],
            "aliases": {
                "payfast": "zfhassaan\\Payfast\\Facade\\Payfast",
                "PayFast": "zfhassaan\\Payfast\\Facade\\Payfast",
                "Payfast": "zfhassaan\\Payfast\\Facade\\Payfast"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
